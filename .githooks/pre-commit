#!/usr/bin/env bash
# Refuse commits that add a secret. This repo is public.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if command -v gitleaks >/dev/null; then
  gl=(gitleaks)
else
  gl=(nix run nixpkgs#gitleaks --)
fi
if ! "${gl[@]}" git --pre-commit --staged --redact --no-banner --config .gitleaks.toml . ; then
  echo >&2 "pre-commit: gitleaks found a secret in the staged changes. Seal it (kubeseal) instead of committing it."
  exit 1
fi
